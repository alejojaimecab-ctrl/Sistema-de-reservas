VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Secrets de servidor (NO exponer con prefijo VITE_)
RESEND_API_KEY=tu-api-key-de-resend
REMINDER_SECRET=tu-secreto-compartido-cron

# Dirección pública del sitio, sin barra final (ej. https://reser.com.ar). Solo para compilar en el hosting:
# completa canonical / og:url / og:image y genera sitemap.xml. Sin ella el sitio funciona igual.
VITE_SITE_URL=

# CAPTCHA (Cloudflare Turnstile) del ingreso, alta y recuperar contraseña. La clave del SITIO va acá; la SECRETA
# va en Supabase → Authentication → Attack Protection. Sin esta variable no se pide CAPTCHA.
# Para probar en localhost: 1x00000000000000000000AA (siempre pasa).
VITE_TURNSTILE_SITE_KEY=
